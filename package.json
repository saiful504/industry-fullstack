{
  "name": "industry-fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm run dev --workspace=@app/web\" \"npm run dev --workspace=@app/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
